generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  FACILITY_STAFF
  ADMIN
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  password    String
  firstName   String?
  lastName    String?
  role        UserRole @default(FACILITY_STAFF)
  isActive    Boolean  @default(true)
  isSetupDone Boolean  @default(false)
  createdAt   DateTime @default(now())

  facilityStaff FacilityStaff?
  token         Token[]
  refreshToken  RefreshToken[]
  activityLogs  ActivityLog[]

  @@index([role])
  @@map("users")
}

enum FacilityStatus {
  AVAILABLE
  UNAVAILABLE
  /// Legacy value still present in the DB enum (historical drift) — kept so
  /// rows carrying it deserialize instead of breaking every read. No app
  /// feature creates it; treat it as AVAILABLE-era legacy in status maps.
  LIMITED
}

model Facility {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  address     String
  note        String?
  maxCapacity Int
  status      FacilityStatus @default(AVAILABLE)
  latitude    Decimal        @db.Decimal()
  longitude   Decimal        @db.Decimal()
  createdAt   DateTime       @default(now())
  deletedAt   DateTime?

  staff        FacilityStaff[]
  resource     FacilityResource[]
  FacilityStay FacilityStay[]
  activityLogs ActivityLog[]

  /// LIVE DB deviation (2026-10-25 audit): the coordinate uniqueness is a
  /// PARTIAL unique index over ACTIVE rows only
  /// (`facilities_longitude_latitude_key ... WHERE "deletedAt" IS NULL`) —
  /// soft-deleted facilities must not block reusing their coordinates.
  /// Prisma cannot express partial indexes, so the declaration below stays a
  /// full @@unique (it also keeps the `longitude_latitude` unique input used
  /// by facility.services). Future `prisma migrate diff` runs will suggest
  /// re-creating the full unique — prune that statement.
  @@unique([longitude, latitude])
  @@map("facilities")
}

enum EvacueeAgeGroup {
  CHILD
  ADULT
}

model FacilityStay {
  id         String @id @default(uuid()) @db.Uuid
  facilityId String @db.Uuid

  familyName String
  /// Human-readable Check-In ID: "0001" — a zero-padded per-facility ticket
  /// number (4 digits, cap 9999 per center). Unique within the facility.
  checkInCode String

  checkedInAt  DateTime  @default(now())
  checkedOutAt DateTime?

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  members FacilityStayMember[]

  @@index([facilityId, checkedOutAt])
  @@index([facilityId, checkedInAt])
  @@unique([facilityId, checkInCode])
  @@map("facility_stays")
}

model FacilityStayMember {
  id     String @id @default(uuid()) @db.Uuid
  stayId String @db.Uuid

  fullName String
  ageGroup EvacueeAgeGroup

  stay FacilityStay @relation(fields: [stayId], references: [id], onDelete: Cascade)

  @@index([stayId])
  @@map("facility_stay_members")
}

enum FacilityResourceType {
  QUANTITY
  BOOLEAN
}

/// The three mandatory essential resources every facility must carry.
enum EssentialResourceType {
  ELECTRICITY
  WATER
  COMFORT_ROOM
}

model FacilityResource {
  id             String               @id @default(uuid()) @db.Uuid
  facilityId     String               @db.Uuid
  name           String
  type           FacilityResourceType @default(QUANTITY)
  isAvailable    Boolean?
  availableValue Int?
  maxValue       Int?
  /// Stable identifier for the mandatory essentials (NULL = custom resource).
  essentialType  EssentialResourceType?

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, type])
  /// One row per mandatory essential per facility (custom rows are NULL and
  /// never collide — Postgres treats NULLs as distinct in unique indexes).
  @@unique([facilityId, essentialType])
  /// One NAME per facility (DB-07): duplicate-name creates were check-then-act
  /// races with nothing behind them.
  @@unique([facilityId, name])
  @@map("facility_resource")
}

model FacilityStaff {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @db.Uuid
  facilityId String   @db.Uuid
  joinedAt   DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  /// The two redundant indexes formerly declared here (facilityId, userId
  /// singles) were dropped in the 2026-10-25 audit migration: userId is
  /// covered by its @unique index and facilityId is the leftmost prefix of
  /// the (facilityId, userId) unique index.
  @@unique([facilityId, userId])
  @@map("facility_staff")
}

enum TokenType {
  EMAIL_VERIFY
  REQ_RESET_PASS
  RESET_PASS
}

model Token {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  token     String    @unique
  type      TokenType
  payload   Json?
  createdAt DateTime  @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type, userId])
  @@map("token")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  token     String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  rotatedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_token")
}

enum ActivityAction {
  AUTH_LOGIN
  AUTH_SIGN_OUT
  AUTH_SIGN_OUT_ALL
  AUTH_PASSWORD_RESET_REQUESTED
  AUTH_PASSWORD_RESET
  FACILITY_CREATED
  FACILITY_UPDATED
  FACILITY_DELETED
  FACILITY_RESTORED
  STAFF_ACCOUNT_CREATED
  STAFF_ACCOUNT_UPDATED
  STAFF_ACTIVATED
  STAFF_DEACTIVATED
  STAFF_PASSWORD_RESET
  STAFF_DELETED
  STAFF_ASSIGNED
  STAFF_DISMISSED
  RESOURCE_CREATED
  RESOURCE_UPDATED
  RESOURCE_DELETED
  STAY_CHECKED_IN
  STAY_CHECKED_OUT
}

// Append-only activity log (no write API — rows are created server-side at
// mutation points only). Actor/facility name snapshots are denormalized so
// entries stay readable after the referenced records are deleted.
model ActivityLog {
  id           String         @id @default(uuid()) @db.Uuid
  action       ActivityAction
  actorId      String?        @db.Uuid
  actorEmail   String
  actorName    String?
  actorRole    UserRole
  facilityId   String?        @db.Uuid
  facilityName String?
  targetId     String?        @db.Uuid
  targetLabel  String?
  metadata     Json?
  createdAt    DateTime       @default(now())

  actor    User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  facility Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([facilityId, createdAt])
  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@map("activity_log")
}
