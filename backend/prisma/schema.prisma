generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  FACILITY_STAFF
  ADMIN
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  password    String
  firstName   String?
  lastName    String?
  role        UserRole @default(FACILITY_STAFF)
  isSetupDone Boolean  @default(false)
  createdAt   DateTime @default(now())

  facilityStaff FacilityStaff?
  token         Token[]
  refreshToken  RefreshToken[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Facility {
  id        String             @id @default(uuid()) @db.Uuid
  name      String
  address   String             @unique
  notes     String
  latitude  Decimal            @db.Decimal(11, 9)
  longitude Decimal            @db.Decimal(11, 9)
  createdAt DateTime           @default(now())
  staff     FacilityStaff[]
  resource  FacilityResource[]

  @@map("facilities")
}

enum FacilityResourceType {
  FIXED_VALUE
  DYNAMIC_VALUE
}

model FacilityResource {
  id             String               @id @default(uuid()) @db.Uuid
  facilityId     String               @db.Uuid
  name           String
  type           FacilityResourceType @default(FIXED_VALUE)
  isAvailable    Boolean?
  availableValue Int?
  maxValue       Int?

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, type])
  @@map("facility_resource")
}

model FacilityStaff {
  id         String   @id @default(uuid()) @db.Uuid
  staffId    String   @unique @db.Uuid
  facilityId String   @db.Uuid
  joinedAt   DateTime @default(now())

  user     User     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId])
  @@index([staffId])
  @@map("facility_staff")
}

enum TokenType {
  EMAIL_VERIFY
  REQ_RESET_PASS
  RESET_PASS
}

model Token {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  token     String    @unique
  type      TokenType
  payload   Json?
  createdAt DateTime  @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type, userId])
  @@map("token")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_token")
}
