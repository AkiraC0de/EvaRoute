generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  FACILITY_STAFF
  ADMIN
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  password    String
  firstName   String?
  lastName    String?
  role        UserRole @default(FACILITY_STAFF)
  isSetupDone Boolean  @default(false)
  createdAt   DateTime @default(now())

  facilityStaff FacilityStaff?
  token         Token[]
  refreshToken  RefreshToken[]

  @@index([email])
  @@index([role])
  @@map("users")
}

enum FacilityStatus {
  AVAILABLE
  UNAVAILABLE
}

model Facility {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  address     String
  note        String?
  maxCapacity Int
  status      FacilityStatus @default(AVAILABLE)
  latitude    Decimal        @db.Decimal()
  longitude   Decimal        @db.Decimal()
  createdAt   DateTime       @default(now())
  deletedAt   DateTime?

  staff        FacilityStaff[]
  resource     FacilityResource[]
  FacilityStay FacilityStay[]

  @@unique([longitude, latitude])
  @@map("facilities")
}

enum EvacueeAgeGroup {
  CHILD
  ADULT
}

model FacilityStay {
  id         String @id @default(uuid()) @db.Uuid
  facilityId String @db.Uuid

  familyName String

  checkedInAt  DateTime  @default(now())
  checkedOutAt DateTime?

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  members FacilityStayMember[]

  @@index([facilityId, checkedOutAt])
}

model FacilityStayMember {
  id     String @id @default(uuid()) @db.Uuid
  stayId String @db.Uuid

  fullName String
  ageGroup EvacueeAgeGroup

  stay FacilityStay @relation(fields: [stayId], references: [id], onDelete: Cascade)

  @@index([stayId])
}

enum FacilityResourceType {
  QUANTITY
  BOOLEAN
}

model FacilityResource {
  id             String               @id @default(uuid()) @db.Uuid
  facilityId     String               @db.Uuid
  name           String
  type           FacilityResourceType @default(QUANTITY)
  isAvailable    Boolean?
  availableValue Int?
  maxValue       Int?

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, type])
  @@map("facility_resource")
}

model FacilityStaff {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @db.Uuid
  facilityId String   @db.Uuid
  joinedAt   DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, userId])
  @@index([facilityId])
  @@index([userId])
  @@map("facility_staff")
}

enum TokenType {
  EMAIL_VERIFY
  REQ_RESET_PASS
  RESET_PASS
  FACILITY_SETUP
}

model Token {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  token     String    @unique
  type      TokenType
  payload   Json?
  createdAt DateTime  @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type, userId])
  @@map("token")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_token")
}
