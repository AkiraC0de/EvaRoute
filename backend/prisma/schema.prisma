generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url = ENV("DATABASE_URL") //ignore
}

enum UserRole {
  FACILITY_STAFF
  ADMIN
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  password    String
  firstName   String
  lastName    String
  role        UserRole @default(FACILITY_STAFF)
  isSetupDone Boolean  @default(false)
  createdAt   DateTime @default(now())

  facilityStaff FacilityStaff?
  token         Token[]

  @@map("users")
}

